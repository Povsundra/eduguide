# Environment Variables — documented in Sub-Phase 1.8
# Copy this file to .env and fill in values before running the application.

# -------------------------------------------------------------------------
# Application
# -------------------------------------------------------------------------
APP_NAME="EduGuide API"
ENVIRONMENT="development"
CORS_ORIGINS='["http://localhost", "http://localhost:80", "http://localhost:5173"]'

# -------------------------------------------------------------------------
# Databases
# -------------------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://eduguide:eduguide_password@postgres:5432/eduguide_db"
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="eduguide_password"
REDIS_URL="redis://redis:6379/0"
